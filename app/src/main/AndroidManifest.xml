            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherMinGold"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_mingold"
            android:roundIcon="@mipmap/ic_launcher_mingold"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherMinNeon"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_minneon"
            android:roundIcon="@mipmap/ic_launcher_minneon"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherMinPixel"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_minpixel"
            android:roundIcon="@mipmap/ic_launcher_minpixel"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <receiver
            android:name=".widget.TodayWidget"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_info" />
        </receiver>
    </application>
</manifest>
