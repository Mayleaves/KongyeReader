<?xml version="1.0" encoding="utf-8"?>
<!-- 根布局用 @android:id/background，Android 12+ 桌面会按系统圆角裁剪，猫可以“探出”到边缘 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg">

    <ImageView
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="-14dp"
        android:layout_marginBottom="-16dp"
        android:contentDescription="@null"
        android:src="@drawable/widget_cat" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="14dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_label"
            android:textColor="@color/widget_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/widget_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/widget_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/widget_sub"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
